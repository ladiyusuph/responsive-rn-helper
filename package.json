{
  "name": "@ladiyusuph/responsive-rn",
  "version": "1.0.13",
  "description": "Responsive design system for Expo and React Native: window size tiers, typed design tokens, createStyles, and layout primitives.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir dist/cjs",
    "build:esm": "tsc -p tsconfig.build.json --module esnext --outDir dist/esm",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir dist/types",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "react-native",
    "expo",
    "responsive",
    "breakpoints",
    "layout",
    "typography",
    "ui",
    "design-system",
    "design-tokens",
    "stylesheet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ladiyusuph/responsive-rn-helper.git"
  },
  "homepage": "https://github.com/ladiyusuph/responsive-rn-helper#readme",
  "bugs": {
    "url": "https://github.com/ladiyusuph/responsive-rn-helper/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.71.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.79",
    "jest": "^30.4.2",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
